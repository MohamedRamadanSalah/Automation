# ============================================================
# AI Trend Intelligence Platform — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Database ---
POSTGRES_DB=trendintel
POSTGRES_USER=trendintel
POSTGRES_PASSWORD=changeme_strong_password

# --- OpenRouter (required) ---
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY
# Primary model — strongest verified FREE model on OpenRouter (550B).
OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Ordered free fallbacks — OpenRouter auto-routes here when the primary is rate-limited (429).
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-120b:free,meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-next-80b-a3b-instruct:free,nousresearch/hermes-3-llama-3.1-405b:free

# --- n8n ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_n8n_password
N8N_ENCRYPTION_KEY=changeme_32char_encryption_key_here
N8N_WEBHOOK_URL=http://localhost:5678

# --- FastAPI optional API key (leave blank to disable auth) ---
API_KEY=

# --- Agent behaviour ---
AGENT_CONCURRENCY=3
AGENT_MAX_RETRIES=3
REVIEW_MAX_ATTEMPTS=3
REVIEW_PASS_THRESHOLD=7

# --- Discovery thresholds ---
POPULARITY_THRESHOLD=10
TOP_N=15

# --- Logging ---
LOG_LEVEL=INFO

# --- Timezone ---
TIMEZONE=UTC

# --- Optional source credentials (enable sources that need them) ---
# GitHub (increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# Reddit OAuth app credentials
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TrendIntel/1.0 (by /u/your_username)

# Product Hunt API token
PRODUCTHUNT_TOKEN=
